# --- Runtime ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Some campus/hostel networks block SRV DNS; Google DNS works around that.
DNS_SERVERS=8.8.8.8,8.8.4.4

# --- Database ---
MONGO_URI=your_mongodb_connection_string_here

# --- Tokens (must be 32+ characters each) ---
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Field-level encryption ---
# AES_SECRET_KEY must be 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AES_SECRET_KEY=replace_with_a_32_plus_character_random_secret
AES_KEY_ID=k1
# During key rotation, move the old key here, then run scripts/rotate-encryption.js
# AES_KEY_ID_PREVIOUS=k0
# AES_SECRET_KEY_PREVIOUS=previous_secret_here

# --- Compliance / retention ---
RETENTION_YEARS=7
DSAR_RESPONSE_DAYS=30
PRIVACY_NOTICE_VERSION=2026-11
